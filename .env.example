# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables (Preview environment).

# Optional: forward every saved lead as JSON to this URL (Zapier/Make hook, CRM, etc.).
# Leave unset to disable forwarding.
LEAD_WEBHOOK_URL=

# Optional at launch: the real site URL, used for canonical links, sitemap and robots.
SITE_URL=
